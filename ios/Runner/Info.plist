	<string>This app needs location access to show your current location on the map and provide location-based services.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>This app needs microphone access for recording audio in videos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>This app needs access to your photo library to select and save photos and videos.</string>
	<key>NSUserNotificationUsageDescription</key>
	<string>This app needs notification permission to show download progress.</string>
