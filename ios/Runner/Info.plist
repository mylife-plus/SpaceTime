	<string>SpaceTime does not use Apple Music. This key is required by Apple because an included SDK references media APIs. Photo and video picking uses the photo library descriptions above.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_https._tcp</string>
	</array>
