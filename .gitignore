# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# iOS/macOS
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/DerivedData/
**/ios/**/Icon?
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/profile
**/ios/**/xcuserdata
**/ios/**/.generated/
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*

# macOS
**/macos/**/*.mode1v3
**/macos/**/*.mode2v3
**/macos/**/*.moved-aside
**/macos/**/*.pbxuser
**/macos/**/*.perspectivev3
**/macos/**/DerivedData/
**/macos/**/Icon?
**/macos/**/Pods/
**/macos/**/.symlinks/
**/macos/**/profile
**/macos/**/xcuserdata
**/macos/**/.generated/
**/macos/Flutter/ephemeral/
**/macos/Flutter/GeneratedPluginRegistrant.swift

# Linux
**/linux/**/flutter/ephemeral/

# Windows
**/windows/**/flutter/ephemeral/

# Web (only ignore build output, not source)
/web/build/

# Coverage
coverage/

# Exceptions to above rules.
!**/ios/**/default.mode1v3
!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3

# Android specific
**/android/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/GeneratedPluginRegistrant.java
**/android/.cxx/
**/android/key.properties
**/android/**/*.keystore
**/android/**/*.jks

# Generated files
**/generated_plugin_registrant.dart
**/generated_plugin_registrant.cc
**/generated_plugin_registrant.h
**/generated_plugins.cmake
**/GeneratedPluginRegistrant.swift

# Build outputs
**/build/
**/out/

# Temporary files
*.tmp
*.temp

# Lock files that should be ignored
# Note: pubspec.lock should be committed for Flutter apps
# pubspec.lock
**/Podfile.lock

# Development tools
devtools_options.yaml

# Large data files (optional - uncomment if you want to ignore these)
# assets/cities*.txt
# assets/*.csv
# assets/data/

# MBTiles files (offline map tiles - too large for git)
assets/*.mbtiles
**/*.mbtiles

# FVM Version Cache
.fvm/

# Environment variables and secrets
.env
.env.*
*.env
!.env.example

# Firebase configuration (if using Firebase)
# Uncomment these if you want to keep Firebase config private
# **/google-services.json
# **/GoogleService-Info.plist
# firebase.json
# .firebaserc

# API keys and secrets
**/secrets.dart
**/api_keys.dart
**/config/secrets.dart

# Database files (if storing locally for development)
*.db
*.sqlite
*.sqlite3

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates